        "evidence_status": "unverified",
        "output_status": "supported"
      },
      "expected_outcome": "supported",
      "expected_evidence_status": "unverified",
      "handler_must_not_run": false
    },
    {
      "case_id": "contradictory-canonical-measurement",
      "threat_class": "contradictory_measurement",
      "route": "response",
      "response": {
        "evidence_status": "canonical",
        "output_status": "supported"
      },
      "expected_outcome": "failed",
      "expected_failure_code": "output_invalid",
      "handler_must_not_run": false
    },
    {
