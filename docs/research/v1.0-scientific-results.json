  "claims": [
    {"claim_id": "q1_static_baseline", "run_ids": ["run_v08_q1_22c8a0f14068a779"], "claim": "Static weight statistics alone did not reliably discriminate safe masks; this is a baseline, not a sufficient predictor."},
    {"claim_id": "q2_activation_null", "run_ids": ["run_v08_q2_3f0379957e221045"], "claim": "Activation summaries produced no statistically resolved paired gain in the bounded three-model study."},
    {"claim_id": "q3_gradient_signal", "run_ids": ["run_v08_q3_5a3a1899a017a5c6"], "claim": "Gradient summaries added a strong held-out ranking and regression signal on the three target models."},
    {"claim_id": "q4_ranker_baseline", "run_ids": ["run_v08_q4_25669a86b765182a"], "claim": "The learned ranker selected zero violations in the tested equal-budget folds, while magnitude and random baselines violated the threshold."},
    {"claim_id": "q5_unseen_model", "run_ids": ["run_v08_q5_2873bcbd7d44d694"], "claim": "Cross-model ranking transferred to one unseen checkpoint, but probability calibration degraded."},
    {"claim_id": "q6_cross_family", "run_ids": ["run_v08_q6_c931808c2601833d"], "claim": "Held-out-family ranking remained useful, while cross-family ΔPPL regression was not supported."},
    {"claim_id": "q7_active_learning", "run_ids": ["run_v08_q7_5a0b1827185c4fed"], "claim": "Active acquisition reduced experiments for Qwen2.5-0.5B but did not establish a model-general advantage over random."},
    {"claim_id": "q8_iterative_masking", "run_ids": ["run_v08_q8_1eb57f43b3547237"], "claim": "Iterative masking slightly improved the bounded cumulative quality result at higher study cost and did not produce latency gains."},
    {"claim_id": "quantized_features", "run_ids": ["run_v08_quant_features_e0457bedc3c4151e"], "claim": "Locally dequantized RMS-like features retained high rank correlation, while signed means and sparsity require error-aware handling."},
    {"claim_id": "quantization_loss", "run_ids": ["run_v08_quant_loss_e17e29f0b10e9c54"], "claim": "Requantization loss decreased with precision and was approximately additive with the fixed surgery in the sampled tensor study."},
    {"claim_id": "consumer_scale", "run_ids": ["run_v08_scale_3f05c9f40ec8a7b0"], "claim": "The seven-model ladder completed the bounded protocol on one consumer host; the largest model required CPU offload."},
    {"claim_id": "performance_guardrails", "run_ids": ["run_v10_performance_dc6983615e0ffcb4"], "claim": "The v1.0 performance profiles passed their 18 measured budgets on the reference workstation."}
