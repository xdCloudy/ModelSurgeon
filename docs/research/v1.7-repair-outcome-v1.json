{
  "record_type": "unified_repair_outcome_protocol",
  "schema_version": 1,
  "protocol_revision": "repair-outcome-v1",
  "methods": [
    "no_repair",
    "lora",
    "selected_finetune",
    "full_finetune",
    "logit_distillation",
    "feature_distillation"
  ],
  "required_lineage": [
    "parent",
    "source",
    "candidate",
    "teacher_when_distilling",
    "data_revision",
    "tokenizer_digest"
  ],
  "required_outcome_evidence": [
    "heldout_improvement",
    "step_token_time_gpu_energy_disk_cost",
    "artifact_bytes_reconciliation",
    "rollback_or_commit_transition"
  ],
  "rejection_policy": "restore exact candidate and prevent rejected/failed outcomes from becoming search parents",
  "artifact_policy": "children are immutable and adapter/merged/separate outputs reconcile to declared disk cost",
  "reproduction": "RepairOutcomeManifest and record_repair_result()",
  "dataset": {
    "schema_version": 1,
    "protocol_revision": "repair-dataset-v1",
    "record_type": "matched_repair_recoverability_dataset",
    "required_controls": ["same_damaged_candidate", "same_heldout_groups", "same_budget"],
    "required_outcomes": ["accepted", "rejected", "failed", "unsupported", "unknown"],
    "default_budgets": ["zero", "short", "medium"],
    "minimum_model_families": 2,
    "minimum_mutation_kinds": 2,
    "minimum_seeds": 2,
    "split_rule": "complete lineage groups are assigned to exactly one of train, validation, or test",
    "reproduction": "build_repair_dataset()"
  }
}
